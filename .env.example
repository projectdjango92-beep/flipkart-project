# Copy this file to .env and use a private, unique Django secret key.
DJANGO_SECRET_KEY=replace-with-a-private-django-secret-key
# Keep False on Render. Set True only for local development.
DJANGO_DEBUG=False
# Comma-separated host names; do not include a protocol or trailing slash.
DJANGO_ALLOWED_HOSTS=your-service-name.onrender.com
# Comma-separated complete origins, including https://.
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service-name.onrender.com
# Optional locally. On Render, set this to a path on the persistent disk.
DJANGO_DB_PATH=/var/data/db.sqlite3
# Leave True unless you intentionally terminate TLS somewhere other than Render.
DJANGO_SECURE_SSL_REDIRECT=True
# Optional: set this plus Django's standard EMAIL_* variables to enable password-reset emails.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
